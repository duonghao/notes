{
  "name": "@notes/draw-react",
  "description": "React adapter for draw",
  "version": "0.0.0",
  "private": "true",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest",
    "test:dev": "pnpm test --watch"
  },
  "dependencies": {
    "@notes/draw": "workspace:*"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  }
}
